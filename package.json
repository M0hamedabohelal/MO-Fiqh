{
  "name": "fqh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo.mjs && vite build && node scripts/purge-bootstrap.mjs",
    "build:live": "node scripts/generate-seo.mjs --live && vite build && node scripts/purge-bootstrap.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "deadcode": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "vitest run src/firebase/rules.test.ts",
    "test:rules:emulator": "npx --yes firebase-tools@15 emulators:exec --only firestore \"npm run test:rules\"",
    "backup": "node scripts/backup-firestore.mjs",
    "check:backup-key": "node scripts/check-backup-key.mjs",
    "restore": "node scripts/restore-firestore.mjs",
    "audit:data": "node scripts/audit-content.mjs",
    "audit:glossary": "node scripts/audit-glossary.mjs",
    "migrate": "node scripts/migrate-to-firestore.mjs",
    "brand": "node scripts/build-brand-assets.mjs",
    "setup:fonts": "node scripts/setup-local-fonts.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "upload:pdf": "node scripts/upload-pdf.mjs",
    "deploy": "npm run deploy:hosting",
    "deploy:hosting": "npm run typecheck && npm run build && npx -y --engine-strict=false firebase-tools@15 deploy --only hosting",
    "deploy:rules": "npx -y --engine-strict=false firebase-tools@15 deploy --only firestore:rules",
    "deploy:all": "npm run typecheck && npm run build && npx -y --engine-strict=false firebase-tools@15 deploy --only hosting,firestore:rules",
    "content:snapshot": "node scripts/snapshot-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "update:readme": "node scripts/update-readme-stats.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "12.18.0",
    "framer-motion": "12.38.0",
    "fuse.js": "^7.3.0",
    "html-to-image": "^1.11.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.0",
    "globals": "^17.5.0",
    "jsdom": "^30.1.3",
    "knip": "^5.88.1",
    "purgecss": "^8.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
