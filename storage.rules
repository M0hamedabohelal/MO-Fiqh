rules_version = '2';

// قواعد التخزين — الباحث الفقهي
// ملاحظة: التطبيق لا يستخدم Firebase Storage أصلًا (الرفع يتم عبر Cloudinary)،
// لذا كل الوصول من العميل مغلق افتراضيًا. افتحه فقط عند الحاجة الفعلية.
service firebase.storage {
  match /b/{bucket}/o {
    // ملفات عامة للتحميل المباشر (مثل كتاب الفقه الميسر PDF)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
