rules_version = '2';

// قواعد Firestore — الباحث الفقهي
// المبدأ: قراءة المحتوى للجميع، الكتابة للأدمن فقط، وبيانات كل مستخدم له وحده.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // المشرف = مستخدم مسجل وله مستند في مجموعة admins (يُدار من الكونسول فقط)
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── المحتوى العام: قراءة للجميع، كتابة للأدمن فقط ───
    match /lessons/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // سجل تغييرات واستعادة المسائل — للمشرفين فقط، وسجلات الإصدارات لا تُعدّل أو تُحذف.
    match /lessonRevisions/{lessonDocId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['lesson', 'savedAt'])
          && request.resource.data.lesson is map
          && request.resource.data.savedAt is number;
        allow update, delete: if false;
      }
    }

    match /glossary/{term} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── عدّادات التسلسل (counters/lessons): قراءة للجميع، كتابة للأدمن فقط ───
    // تُستخدم لحجز معرفات المسائل ذريًا ومنع التعارض بين مشرفَين
    match /counters/{counterId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── سجل المشرفين: كل مستخدم يقرأ سجله فقط (لفحص الصلاحية)، ولا كتابة من العميل ───
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // ─── بيانات المستخدم الخاصة: أُزيلت مع طبقة المزامنة ───
    // (كانت: users/{uid}/data و users/{uid}/stopMarksV2). البيانات القديمة ما زالت
    // في القاعدة لكن لا كود يقرأها أو يكتبها، فالمسار مغلق افتراضيًا عبر القاعدة العامة
    // في نهاية الملف (match /{document=**} → allow false) حتى تُعاد المزامنة من جديد.

    // ─── إحصائيات المشاهدات: قراءة للجميع، وتحديث تراكمي للجميع (تتبع مجهول من trackLessonView) ───
    // القيد يمنع العبث الواسع: الإنشاء بمفتاح واحد فقط، وكل تحديث يمس مفتاحًا واحدًا
    // بالضبط (بلا حذف، ونمو مفتاح واحد كحد أقصى لكل كتابة). العميل الشرعي يكتب مفتاحًا
    // واحدًا في كل مرة (increment) فيبقى متوافقًا، وأي كتابة تمس عدة عدادات دفعة واحدة تُرفض.
    // ⚠️ لا تُشدَّد إلى «عدد مفاتيح ثابت»: أول مشاهدة لمسألة جديدة **تُضيف** مفتاحًا،
    // فالتشديد يمنع احتساب أي مسألة تُضاف مستقبلًا (اختُبر عمليًا: 403).
    // (متبقٍّ معلوم: قيمة المفتاح نفسه لا يمكن تقييدها بزيادة +1 لأن أسماء المفاتيح ديناميكية —
    //  لذلك يقلّل العميل عدد الكتابات: كتابة واحدة لكل مسألة في الجلسة، انظر trackLessonView)
    match /stats/views {
      allow read: if true;
      allow create: if request.resource.data.keys().size() == 1;
      allow update: if request.resource.data.diff(resource.data).removedKeys().size() == 0
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.keys().size() <= resource.data.keys().size() + 1;
      allow delete: if isAdmin();
    }

    // ─── سجل أخطاء العميل: إنشاء للمسجلين فقط بصيغة مقيدة، قراءة/حذف للأدمن ───
    // التقييد يمنع تحويل المجموعة لمخزن بيانات مجاني: حقول ثابتة وأطوال قصوى فقط،
    // وتتوافق تمامًا مع ما يكتبه logError.ts (scope/message/at/url/extra — والرسالة ≤300 أصلًا)
    match /client_errors/{docId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['scope', 'message', 'extra', 'url', 'at', 'expireAt'])
        && request.resource.data.scope is string
        && request.resource.data.scope.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 300
        && request.resource.data.url is string
        && request.resource.data.url.size() <= 500
        && request.resource.data.at is number
        && request.resource.data.expireAt is timestamp
        && (request.resource.data.extra == null
          || (request.resource.data.extra is map && request.resource.data.extra.size() <= 10));
      allow update: if false;
    }

    // ─── افتراضي: منع أي مسار آخر ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
